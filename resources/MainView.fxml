<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" styleClass="app-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.ui.MainController">
   <top>
      <VBox spacing="12.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="18.0" right="18.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="app-title" text="Algorithm Visualizer" />
                  <Label styleClass="app-subtitle" text="Step through data structures and algorithms" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="control-row">
               <children>
                  <Button fx:id="btnLoad" mnemonicParsing="false" onAction="#onLoad" styleClass="primary-button" text="Load" />
                  <Button fx:id="btnReset" mnemonicParsing="false" onAction="#onReset" text="Reset" />
                  <Button fx:id="btnPrev" mnemonicParsing="false" onAction="#onPrev" text="Prev" />
                  <Button fx:id="btnNext" mnemonicParsing="false" onAction="#onNext" text="Next" />
                  <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#onPlay" styleClass="primary-button" text="Play" />
                  <Button fx:id="btnPause" mnemonicParsing="false" onAction="#onPause" text="Pause" />
                  <ComboBox fx:id="cmbViewMode" onAction="#changeOptionSelected" prefWidth="150.0" />
                  <ComboBox fx:id="cmbAlgorithm" onAction="#changeAlgoSelected" prefWidth="190.0" promptText="Algorithm" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <right>
      <VBox prefWidth="230.0" spacing="12.0" styleClass="side-panel" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
         </padding>
         <children>
            <Label styleClass="panel-title" text="Run State" />
            <Label fx:id="lblStepCount" styleClass="metric-label" text="Steps: 0 / 0" />
            <Label fx:id="lblComparisons" styleClass="metric-label" text="Comparisons: 0" />
            <Label fx:id="lblSwaps" styleClass="metric-label" text="Swaps: 0" />
            <Label fx:id="lblWrites" styleClass="metric-label" text="Writes: 0" />
            <Label fx:id="lblStatus" styleClass="status-label" text="Ready" wrapText="true" />
            <Label fx:id="lblNoOps" styleClass="event-label" text="" wrapText="true" />
            <TextField fx:id="inputTXTField" promptText="Enter value" />
            <Button fx:id="submitTxtField" maxWidth="Infinity" mnemonicParsing="false" onAction="#onOperationSubmit" styleClass="primary-button" text="Submit" />
         </children>
      </VBox>
   </right>
   <center>
      <Pane fx:id="renderPane" prefHeight="1000.0" prefWidth="760.0" styleClass="render-pane" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
