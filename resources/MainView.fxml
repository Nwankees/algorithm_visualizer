<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.ui.MainController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnLoad" mnemonicParsing="false" onAction="#onLoad" text="Load" />
            <Button fx:id="btnReset" mnemonicParsing="false" onAction="#onReset" text="Reset" />
            <Button fx:id="btnPrev" mnemonicParsing="false" onAction="#onPrev" text="Prev" />
            <Button fx:id="btnNext" layoutX="104.0" layoutY="10.0" mnemonicParsing="false" onAction="#onNext" text="Next" />
            <Button fx:id="btnPlay" layoutX="156.0" layoutY="10.0" mnemonicParsing="false" onAction="#onPlay" text="Play" />
            <Button fx:id="btnPause" layoutX="208.0" layoutY="10.0" mnemonicParsing="false" onAction="#onPause" text="Pause" />
         </children>
      </HBox>
   </top>
   <right>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label id="lblComparisons" text="Comparisons: 0" />
            <Label id="lblSwaps" layoutX="10.0" layoutY="10.0" text="Swaps: 0" />
            <Label id="lblStepCount" layoutX="10.0" layoutY="27.0" text="Steps: 0 / 0" />
         </children>
      </VBox>
   </right>
   <center>
      <Pane id="renderPane" prefHeight="1000.0" prefWidth="700.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
